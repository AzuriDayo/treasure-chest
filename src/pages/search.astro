---
import Layout from "../layouts/CollectionPost.astro";
import Search from "astro-pagefind/components/Search.astro";
const title = "Search collection";
const description = "Search the collection";
---

<Layout
  pubDate={new Date("2026-07-28T00:00:00.000Z")}
  showDate={false}
  title={title}
  description={description}
  showDate={false}
>
  <h1>Search</h1>
  <Search
    instance="search"
    className="pagefind-ui"
    searchboxOptions={{ placeholder: "search" }}
  />
</Layout>
