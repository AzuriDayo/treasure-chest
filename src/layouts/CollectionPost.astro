---
import { getImage, Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"collection">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  subImages,
  showDate = true,
} = Astro.props;

const fullSizeSubImages = subImages
  ? await Promise.all(
      subImages.map(async (image) => ({
        src: (await getImage({ src: image })).src,
        width: image.width,
        height: image.height,
      })),
    )
  : [];
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        width: min(100%, 1020px);
        height: auto;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .image-carousel {
        width: 100%;
        max-width: 760px;
        margin: 1.5rem auto 0;
      }
      .embla__viewport {
        padding: 1rem 0;
        overflow: hidden;
      }
      .embla__container {
        display: flex;
        margin-left: -1rem;
        touch-action: pan-y pinch-zoom;
      }
      .embla__slide {
        flex: 0 0 78%;
        min-width: 0;
        padding-left: 1rem;
        opacity: 0.45;
        transition: opacity 0.25s ease;
      }
      .embla__slide.is-selected {
        opacity: 1;
      }
      .carousel-image {
        display: block;
        width: 100%;
        aspect-ratio: 2 / 1;
        padding: 0;
        overflow: hidden;
        cursor: zoom-in;
        background: transparent;
        border: 0;
        transform: scale(0.93);
        transition: transform 0.25s ease;
      }
      .embla__slide.is-selected .carousel-image {
        transform: scale(1);
      }
      .carousel-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
      }
      .embla__slide.is-selected .carousel-image img {
        box-shadow: 0 8px 24px rgba(var(--shadow-color), 35%);
      }
      .carousel-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 0.75rem;
      }
      .carousel-controls button,
      .image-popout__close {
        min-width: 7rem;
        padding: 0.5rem 1rem;
        color: white;
        cursor: pointer;
        background: var(--accent);
        border: 2px solid var(--accent);
        border-radius: 999px;
        box-shadow: 0 2px 6px rgba(var(--shadow-color), 35%);
        transition:
          background 0.2s ease,
          border-color 0.2s ease,
          transform 0.2s ease;
      }
      .carousel-controls button:hover,
      .image-popout__close:hover {
        background: var(--accent-dark);
        border-color: var(--accent-dark);
        transform: translateY(-1px);
      }
      .carousel-position {
        min-width: 4rem;
        text-align: center;
      }
      .image-popout {
        box-sizing: border-box;
        width: 100vw;
        height: 100dvh;
        max-width: none;
        max-height: 100dvh;
        margin: 0;
        padding: 2rem;
        overflow: hidden;
        place-items: center;
        background: transparent;
        border: 0;
      }
      .image-popout[open] {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
      }
      .image-popout::backdrop {
        background: rgba(0, 0, 0, 0.8);
      }
      .image-popout__close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 1;
        width: 2.5rem;
        height: 2.5rem;
        min-width: 0;
        padding: 0;
        font-size: 1.5rem;
        line-height: 1;
      }
      .image-popout__viewport {
        flex: 1 1 0;
        width: 100%;
        max-width: 1020px;
        align-self: center;
        min-height: 0;
        overflow: hidden;
      }
      .image-popout__container {
        display: flex;
        height: 100%;
        touch-action: pan-y pinch-zoom;
      }
      .image-popout__slide {
        display: grid;
        flex: 0 0 100%;
        height: 100%;
        min-width: 0;
        place-items: center;
        position: relative;
      }
      .image-popout__loader {
        position: absolute;
        width: 2.5rem;
        height: 2.5rem;
        border: 0.25rem solid rgba(255, 255, 255, 0.35);
        border-top-color: white;
        border-radius: 50%;
        animation: image-popout-spin 0.75s linear infinite;
      }
      .image-popout__slide:not(.is-loading) .image-popout__loader {
        display: none;
      }
      .image-popout__image {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        border-radius: 12px;
      }
      @keyframes image-popout-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .image-popout__controls {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
      }
      .image-popout__controls button {
        min-width: 7rem;
        padding: 0.5rem 1rem;
        color: white;
        cursor: pointer;
        background: var(--accent);
        border: 2px solid var(--accent);
        border-radius: 999px;
        box-shadow: 0 2px 6px rgba(var(--shadow-color), 35%);
        transition:
          background 0.2s ease,
          border-color 0.2s ease,
          transform 0.2s ease;
      }
      .image-popout__controls button:hover {
        background: var(--accent-dark);
        border-color: var(--accent-dark);
        transform: translateY(-1px);
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }

      @media (prefers-reduced-motion: reduce) {
        .embla__slide,
        .carousel-image,
        .carousel-controls button,
        .image-popout__controls button,
        .image-popout__close,
        .image-popout__loader {
          transition: none;
          animation: none;
        }
      }

      @media (max-width: 720px) {
        .embla__viewport {
          padding: 0;
        }

        .embla__container {
          margin-left: 0;
        }

        .embla__slide {
          flex-basis: 100%;
          padding-left: 0;
          opacity: 1;
          transition: none;
        }

        .carousel-image,
        .embla__slide.is-selected .carousel-image {
          transform: none;
          transition: none;
        }

        .embla__slide.is-selected .carousel-image img {
          box-shadow: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                loading="eager"
                decoding="async"
              />
            )
          }
          {
            subImages && subImages.length > 0 && (
              <div class="image-carousel" data-image-carousel>
                <div class="embla__viewport" data-embla-viewport>
                  <div class="embla__container">
                    {subImages.map((image, index) => (
                      <div class="embla__slide" data-carousel-slide>
                        <button
                          class="carousel-image"
                          type="button"
                          data-carousel-image
                            data-full-image={fullSizeSubImages[index].src}
                          aria-label="Open larger image"
                        >
                          <Image
                            width={1020}
                            src={image}
                              alt=""
                              widths={[320, 480, 640, 768, 1020]}
                              sizes="(max-width: 720px) calc(100vw - 2em), 593px"
                              loading="eager"
                              decoding="async"
                          />
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
                {subImages.length > 1 && (
                  <div class="carousel-controls">
                    <button
                      type="button"
                      data-carousel-previous
                      aria-label="Show previous image"
                    >
                      Previous
                    </button>
                    <span
                      class="carousel-position"
                      data-carousel-position
                      aria-live="polite"
                    >
                      1 / {subImages.length}
                    </span>
                    <button
                      type="button"
                      data-carousel-next
                      aria-label="Show next image"
                    >
                      Next
                    </button>
                  </div>
                )}
                <dialog class="image-popout" data-image-popout>
                  <button
                    class="image-popout__close"
                    type="button"
                    data-image-popout-close
                    aria-label="Close enlarged image"
                  >
                    ×
                  </button>
                  <div class="image-popout__viewport" data-popout-viewport>
                    <div class="image-popout__container">
                      {
                        fullSizeSubImages.map((image) => (
                          <div class="image-popout__slide">
                            <div
                              class="image-popout__loader"
                              aria-label="Loading expanded image"
                              role="status"
                            ></div>
                            <img
                              class="image-popout__image"
                              data-popout-image
                              data-full-image={image.src}
                              src={image.src}
                              width={image.width}
                              height={image.height}
                              loading="eager"
                              alt=""
                            />
                          </div>
                        ))
                      }
                    </div>
                  </div>
                  {
                    fullSizeSubImages.length > 1 && (
                      <div class="image-popout__controls">
                        <button
                          type="button"
                          data-popout-previous
                          aria-label="Show previous expanded image"
                        >
                          Previous
                        </button>
                        <span
                          class="carousel-position"
                          data-popout-position
                          aria-live="polite"
                        >
                          1 / {fullSizeSubImages.length}
                        </span>
                        <button
                          type="button"
                          data-popout-next
                          aria-label="Show next expanded image"
                        >
                          Next
                        </button>
                      </div>
                    )
                  }
                </dialog>
              </div>
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              {showDate && <FormattedDate date={pubDate} />}
              {
                updatedDate && showDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
    <script>
      import EmblaCarousel from "embla-carousel";

      document.querySelectorAll("[data-image-carousel]").forEach((carousel) => {
        const viewport = carousel.querySelector<HTMLElement>(
          "[data-embla-viewport]",
        );
        if (!viewport) return;

        const slides = Array.from(
          carousel.querySelectorAll("[data-carousel-slide]"),
        );
        const position = carousel.querySelector("[data-carousel-position]");
        const previousButton = carousel.querySelector(
          "[data-carousel-previous]",
        );
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const popout = carousel.querySelector<HTMLDialogElement>(
          "[data-image-popout]",
        );
        const popoutViewport = carousel.querySelector<HTMLElement>(
          "[data-popout-viewport]",
        );
        const popoutImages = Array.from(
          carousel.querySelectorAll<HTMLImageElement>("[data-popout-image]"),
        );
        const popoutPosition = carousel.querySelector("[data-popout-position]");
        const popoutPreviousButton = carousel.querySelector(
          "[data-popout-previous]",
        );
        const popoutNextButton = carousel.querySelector("[data-popout-next]");
        const closeButton = carousel.querySelector<HTMLButtonElement>(
          "[data-image-popout-close]",
        );
        const embla = EmblaCarousel(viewport, {
          align: "center",
          loop: slides.length > 1,
        });
        const popoutEmbla = popoutViewport
          ? EmblaCarousel(popoutViewport, {
              align: "center",
              loop: popoutImages.length > 1,
            })
          : undefined;

        const fitPopoutImage = (image: HTMLImageElement | undefined) => {
          if (
            !image ||
            !popout?.open ||
            !popoutViewport ||
            !image.naturalWidth ||
            !image.naturalHeight
          ) {
            return;
          }

          const scale = Math.min(
            popoutViewport.clientWidth / image.naturalWidth,
            popoutViewport.clientHeight / image.naturalHeight,
          );

          image.style.width = `${image.naturalWidth * scale}px`;
          image.style.height = `${image.naturalHeight * scale}px`;
        };

        const fitActivePopoutImage = () => {
          const activeIndex = popoutEmbla?.selectedScrollSnap();
          if (activeIndex === undefined) return;
          fitPopoutImage(popoutImages[activeIndex]);
        };

        const updatePopoutSlide = () => {
          if (!popoutEmbla) return;

          const activeIndex = popoutEmbla.selectedScrollSnap();
          const activeImage = popoutImages[activeIndex];
          const activeSlide = activeImage?.closest<HTMLElement>(
            ".image-popout__slide",
          );
          const fullImageSource = activeImage?.dataset.fullImage;
          if (activeImage && fullImageSource && !activeImage.hasAttribute("src")) {
            activeSlide?.classList.add("is-loading");
            activeImage.src = fullImageSource;
          }
          requestAnimationFrame(fitActivePopoutImage);

          if (popoutPosition) {
            popoutPosition.textContent =
              String(activeIndex + 1) + " / " + popoutImages.length;
          }

          if (popout?.open && embla.selectedScrollSnap() !== activeIndex) {
            embla.scrollTo(activeIndex, true);
          }
        };

        const updateSelectedSlide = () => {
          const activeIndex = embla.selectedScrollSnap();
          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle("is-selected", slideIndex === activeIndex);
          });

          if (position) {
            position.textContent =
              String(activeIndex + 1) + " / " + slides.length;
          }
        };

        previousButton?.addEventListener("click", () => {
          embla.scrollPrev();
        });

        nextButton?.addEventListener("click", () => {
          embla.scrollNext();
        });

        embla
          .on("select", updateSelectedSlide)
          .on("reInit", updateSelectedSlide);
        updateSelectedSlide();

        popoutEmbla
          ?.on("select", updatePopoutSlide)
          .on("reInit", updatePopoutSlide);

        popoutPreviousButton?.addEventListener("click", () => {
          popoutEmbla?.scrollPrev();
        });

        popoutNextButton?.addEventListener("click", () => {
          popoutEmbla?.scrollNext();
        });

        popoutImages.forEach((image) => {
          const hideLoader = () => {
            image
              .closest<HTMLElement>(".image-popout__slide")
              ?.classList.remove("is-loading");
          };
          image.addEventListener("load", () => {
            hideLoader();
            fitPopoutImage(image);
          });
          image.addEventListener("error", hideLoader);
        });
        window.addEventListener("resize", fitActivePopoutImage);

        carousel
          .querySelectorAll<HTMLButtonElement>("[data-carousel-image]")
          .forEach((button) => {
            const sourceImage = button.querySelector<HTMLImageElement>("img");
            if (!sourceImage) return;

            button.addEventListener("mousemove", (event) => {
              const bounds = button.getBoundingClientRect();
              const horizontalPosition =
                ((event.clientX - bounds.left) / bounds.width) * 100;
              const verticalPosition =
                ((event.clientY - bounds.top) / bounds.height) * 100;

              sourceImage.style.objectPosition = `${horizontalPosition}% ${verticalPosition}%`;
            });
            button.addEventListener("mouseleave", () => {
              sourceImage.style.removeProperty("object-position");
            });

            button.addEventListener("click", () => {
              const slide = button.closest<HTMLElement>(
                "[data-carousel-slide]",
              );
              const slideIndex = slide ? slides.indexOf(slide) : -1;

              if (
                slideIndex !== -1 &&
                slideIndex !== embla.selectedScrollSnap()
              ) {
                embla.scrollTo(slideIndex);
                return;
              }

              if (!popout || !popoutEmbla) return;

              popoutEmbla.scrollTo(slideIndex, true);
              popout.showModal();
              popoutEmbla.reInit();
              updatePopoutSlide();
            });
          });

        closeButton?.addEventListener("click", () => popout?.close());
        popout?.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          if (
            target.closest("[data-popout-previous], [data-popout-next]") ||
            target.closest("[data-image-popout-close]")
          ) {
            return;
          }

          const activeImage = popoutImages[popoutEmbla?.selectedScrollSnap() ?? 0];
          if (target === activeImage) return;

          popout.close();
        });
      });
    </script>
  </body>
</html>
